                <row id="727">
                    <method name="onCreate"><![CDATA[var logger = java.util.logging.Logger.getLogger("birt.report.logger");
logger.warning (BirtDateTime.now() + ' Table : ' + this.getRowData().getColumnValue("commodity"));
params["pModel"].value = this.getRowData().getColumnValue("commodity");]]></method>
                    <property name="backgroundColor">#EFF5F9</property>
                    <property name="height">22px</property>
                    <cell id="728">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="borderBottomStyle">none</property>
                        <property name="borderBottomWidth">1px</property>
