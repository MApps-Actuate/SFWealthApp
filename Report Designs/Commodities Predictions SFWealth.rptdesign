                    <property name="name">commodityValue</property>
                    <property name="nativeName">commodityValue</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">prediction</property>
                    <property name="nativeName">prediction</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select ADD_MONTHS((select max("date") from commodities.TestData c where "YY" IS NOT NULL), ROW_NUMBER() OVER (PARTITION BY NULL)) as "date", 'YY' as commodity, NULL::FLOAT  as commodityValue, * from (select PREDICT_VVVV(YY USING PARAMETERS model_name='XXXX', npredictions=WWWW) OVER(ORDER BY date) from commodities.TestData) myPred
--select ADD_MONTHS((select max("date") from commodities.TestData c where "YY" IS NOT NULL), ROW_NUMBER() OVER (PARTITION BY NULL)) as "date", 'YY' as commodity, NULL::FLOAT  as commodityValue, * from (select PREDICT_MOVING_AVERAGE(YY USING PARAMETERS model_name='XXXX', npredictions=WWWW) OVER(ORDER BY date) from commodities.TestData) myPred

union
select "date", commodity, commodityValue, NULL as prediction from commodities.commodities c where commodity = 'YY' 
order by "date"]]></xml-property>
