                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select VVVV('XXXX', 'commodities.TestData', 'YY', 'date' USING PARAMETERS p=LLLL, regularization='L2', lambda=ZZZZ, compute_mse=true) as AUTOREGRESSOR;
--select MOVING_AVERAGE('XXXX', 'commodities.TestData', 'YY', 'date' USING PARAMETERS q=LLLL, regularization='L2', lambda=ZZZZ, compute_mse=true) as AUTOREGRESSOR;
