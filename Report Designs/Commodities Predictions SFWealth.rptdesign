        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Combined Data Set" id="609">
            <list-property name="columnHints"/>
            <list-property name="parameters"/>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">date</property>
                        <property name="dataType">date</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">commodity</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">commodityValue</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">prediction</property>
                        <property name="dataType">float</property>
                    </structure>
                </list-property>
            </structure>
            <property name="needsCache">false</property>
            <method name="beforeOpen"><![CDATA[//var logger = java.util.logging.Logger.getLogger("birt.report.logger");
//logger.warning (BirtDateTime.now() + ' Combined : ' + params["pModel"].value);
this.queryText = this.queryText.replace("VVVV", params["pAnalysisType"].value);
this.queryText = this.queryText.replace("YY", params["pModel"].value);
this.queryText = this.queryText.replace("XXXX", 'AR_' + params["pModel"].value);
this.queryText = this.queryText.replace("WWWW", params["pPredictions"].value.toString());]]></method>
            <property name="dataSource">Vertica Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">date</property>
                    <property name="nativeName">date</property>
                    <property name="dataType">date</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">commodity</property>
                    <property name="nativeName">commodity</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">commodityValue</property>
                    <property name="nativeName">commodityValue</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">prediction</property>
                    <property name="nativeName">prediction</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select ADD_MONTHS((select max("date") from commodities.commodities c where commodity = 'YY'), ROW_NUMBER() OVER (PARTITION BY NULL)) as "date", 'YY' as commodity, NULL::FLOAT  as commodityValue, * from (select PREDICT_VVVV(YY USING PARAMETERS model_name='XXXX', npredictions=WWWW) OVER(ORDER BY date) from commodities.commodities_ct) myPred
union
select "date", commodity, commodityValue, NULL as prediction from commodities.commodities c where commodity = 'YY' 
order by "date"

--run this from the server after data updates:
--CALL commodities.createCT('commodities.date','commodity','commodityValue','commodities.commodities','commodities.commodities_ct');]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Combined Test Data Set" id="658">
            <list-property name="columnHints"/>
            <list-property name="parameters"/>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">date</property>
                        <property name="dataType">date</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">commodity</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">commodityValue</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">prediction</property>
                        <property name="dataType">float</property>
                    </structure>
                </list-property>
            </structure>
            <property name="needsCache">false</property>
            <method name="beforeOpen"><![CDATA[var logger = java.util.logging.Logger.getLogger("birt.report.logger");
logger.warning (BirtDateTime.now() + ' Combined Test: ' + params["pModel"].value);
this.queryText = this.queryText.replace("VVVV", params["pAnalysisType"].value);
this.queryText = this.queryText.replace("YY", params["pModel"].value);
this.queryText = this.queryText.replace("XXXX", 'AR_' + params["pModel"].value + "_Test");
this.queryText = this.queryText.replace("WWWW", "83"); //params["pPredictions"].value.toString());]]></method>
            <property name="dataSource">Vertica Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">date</property>
                    <property name="nativeName">date</property>
                    <property name="dataType">date</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">commodity</property>
                    <property name="nativeName">commodity</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
