        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="Create AR" id="382">
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">AUTOREGRESSOR</property>
                    <property name="analysis">dimension</property>
                    <text-property name="displayName">AUTOREGRESSOR</text-property>
                    <text-property name="heading">AUTOREGRESSOR</text-property>
                </structure>
            </list-property>
            <list-property name="parameters"/>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">AUTOREGRESSOR</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="needsCache">false</property>
            <method name="beforeOpen"><![CDATA[//var logger = java.util.logging.Logger.getLogger("birt.report.logger");
//logger.warning (BirtDateTime.now() + ' Create AR : ' + params["pModel"].value);
this.queryText = this.queryText.replace("VVVV", params["pAnalysisType"].value);
this.queryText = this.queryText.replace("YY", params["pModel"].value);
this.queryText = this.queryText.replace("XXXX", 'AR_' + params["pModel"].value);
this.queryText = this.queryText.replace("LLLL", params["pLag"].value.toString());
this.queryText = this.queryText.replace("ZZZZ", params["pLambda"].value.toString());]]></method>
            <property name="dataSource">Vertica Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">AUTOREGRESSOR</property>
                    <property name="nativeName">AUTOREGRESSOR</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[select VVVV('XXXX', 'commodities.commodities_ct', 'YY', 'date' USING PARAMETERS p=LLLL, regularization='L2', lambda=ZZZZ, compute_mse=true) as AUTOREGRESSOR;
]]></xml-property>
        </oda-data-set>
