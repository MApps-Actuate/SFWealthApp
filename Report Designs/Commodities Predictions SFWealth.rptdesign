            <footer>
                <row id="737">
                    <cell id="738">
                        <property name="colSpan">2</property>
                        <property name="rowSpan">1</property>
                        <property name="backgroundColor">white</property>
                        <property name="borderBottomStyle">none</property>
                        <property name="borderLeftStyle">none</property>
                        <property name="borderRightStyle">none</property>
                        <property name="borderTopStyle">none</property>
                        <text id="732">
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[<script>
// Change the fonts
//
document.querySelectorAll('*').forEach(el => {
  const fontFamily = window.getComputedStyle(el).fontFamily;

  if (fontFamily &amp;&amp; fontFamily.includes('Lato')) {
	el.style.fontFamily = fontFamily.replace(/Lato/g, 'Gibson W04 Regular');
  }
  if (fontFamily &amp;&amp; fontFamily.includes('Lucida Grande')) {
    el.style.fontFamily = fontFamily.replace(/Lucida Grande/g, 'Gibson W04 Regular');
  }  
});

//
// Add the rounded box to the date selectors
//
const groupElements = document.querySelectorAll('g.highcharts-input-group');

groupElements.forEach(groupElement => {
  const newRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
  newRect.setAttribute('class', 'highcharts-label-box');
  newRect.setAttribute('x', '-5');
  newRect.setAttribute('y', '-4');
  newRect.setAttribute('rx', '10');
  newRect.setAttribute('ry', '10');
  newRect.setAttribute('width', '177');
  newRect.setAttribute('height', '28');
  newRect.setAttribute('stroke', 'none');
  newRect.setAttribute('stroke-width', '1');
  newRect.setAttribute('style', 'fill: #f3f3f3;');

  // Insert the new rect as the first child of each group element
  groupElement.insertBefore(newRect, groupElement.firstChild);
});

//
// Added the rounded box to the Zoom and apply a gradient
//
const groups = document.querySelectorAll('g.highcharts-range-selector-buttons');

if (groups.length > 0) {
  
    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
        
    const linearGradient = document.createElementNS('http://www.w3.org/2000/svg', 'linearGradient');
    linearGradient.setAttribute('id', 'fadeGradient');
    linearGradient.setAttribute('x1', '0');
    linearGradient.setAttribute('y1', '0');
    linearGradient.setAttribute('x2', '1');
    linearGradient.setAttribute('y2', '0');

    const stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
    stop1.setAttribute('offset', '0%');
    stop1.setAttribute('stop-color', 'black');
    stop1.setAttribute('stop-opacity', '0.13');

    const stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
    stop2.setAttribute('offset', '100%');
    stop2.setAttribute('stop-color', 'black');
    stop2.setAttribute('stop-opacity', '0');

    linearGradient.appendChild(stop1);
    linearGradient.appendChild(stop2);
    defs.appendChild(linearGradient);
  
  groups.forEach(group => {
  
  
    // Find first <g class="highcharts-label" transform like "translate(X,0)"
    const labelG = group.querySelector('g.highcharts-label[transform^="translate("]');
    let rect1X = 34; // fallback x for rect1
    if (labelG) {
      const transform = labelG.getAttribute('transform');
      const match = transform.match(/translate\(([-\d.]+),\s*0\)/);
      if (match) {
        const parsedX = parseFloat(match[1]);
        if (!isNaN(parsedX)) {
//console.log (parsedX);
			if (parsedX == 40) rect1X = 34;
			else if (parsedX == 59) rect1X = 45;
			
			else
				rect1X = parsedX - 14;
        }
      }
    }
  
    // Find first <g class="highcharts-no-tooltip highcharts-button highcharts-button-normal" transform like "translate(X,0)"
    const buttonG = group.querySelector(
      'g.highcharts-no-tooltip.highcharts-button.highcharts-button-normal[transform^="translate("]'
    );

    let rect2X = 82; // fallback for rect2
    if (buttonG) {
      const transform = buttonG.getAttribute('transform');
      const match = transform.match(/translate\(([-\d.]+),\s*0\)/);
      if (match) {
        const parsedX = parseFloat(match[1]);
        if (!isNaN(parsedX)) {
//console.log (parsedX);        
			if (parsedX == 80) rect2X = 81;
			else if (parsedX == 97) rect2X = 87;
			else
				rect2X = parsedX - 5;
        }
      }
    }
  
    // Create first rect
    const rect1 = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect1.setAttribute('class', 'highcharts-label-box');
   // rect1.setAttribute('x', '34');
    rect1.setAttribute('x', rect1X.toString());
    rect1.setAttribute('y', '-4');
    rect1.setAttribute('rx', '10');
    rect1.setAttribute('ry', '10');
    rect1.setAttribute('width', '274');
    rect1.setAttribute('height', '28');
    rect1.setAttribute('stroke', 'none');
    rect1.setAttribute('stroke-width', '1');
    rect1.setAttribute('style', 'fill: #f3f3f3;');

    // Create second rect with gradient fill
    const rect2 = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    //rect2.setAttribute('x', '86');
    //if (xValue <= 81) xValue= 86;
    //rect2.setAttribute('x', (xValue-5).toString());
    rect2.setAttribute('x', rect2X.toString());
    rect2.setAttribute('y', '-4');
    rect2.setAttribute('width', '7');
    rect2.setAttribute('height', '28');
    rect2.setAttribute('fill', 'url(#fadeGradient)');

    // Insert both as first children (rect2 after rect1)
    group.insertBefore(rect2, group.firstChild);
	group.insertBefore(defs, group.firstChild);
    group.insertBefore(rect1, group.firstChild);
  });
} else {
  console.warn('No <g> elements found with class "highcharts-range-selector-buttons".');
}

</script>]]></text-property>
                        </text>
                    </cell>
                </row>
            </footer>
            <property name="captionFontSize">1.1vw</property>
            <property name="captionTextAlignment">left</property>
        </table>
    </body>
