                        <method name="onCreate"><![CDATA[if (row["Metric"] == 'Credit Limit')
{
	reportContext.setPersistentGlobalVariable("Chart1Percentage", row["Pctg"].toString());
}
else if (row["Metric"] == 'Retirement Goal')
{
	reportContext.setPersistentGlobalVariable("Chart2Percentage", row["Pctg"].toString());
}	
if (row["Metric"] == 'Spending Limit')
{
	reportContext.setPersistentGlobalVariable("Chart3Percentage", row["Pctg"].toString());
}	
if (row["Metric"] == 'Loan Payoff')
{
	reportContext.setPersistentGlobalVariable("Chart4Percentage", row["Pctg"].toString());
}		]]></method>
