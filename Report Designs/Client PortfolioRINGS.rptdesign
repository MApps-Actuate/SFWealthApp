  <extendedProperties name="jschart.client.script" value="beforeGeneration: function(options)&#13;&#10;{&#13;&#10;//////////  HELPER FUNCTION TO CLONE JAVASCRIPT OBJECT&#13;&#10;///&#13;&#10;///&#13;&#10;function clone(obj) {&#13;&#10;    var copy;&#13;&#10;&#13;&#10;    if (null == obj || &quot;object&quot; != typeof obj) return obj;&#13;&#10;&#13;&#10;    // Handle Array&#13;&#10;    if (obj instanceof Array) {&#13;&#10;        copy = [];&#13;&#10;        for (var i = 0, len = obj.length; i &lt; len; i++) {&#13;&#10;            copy[i] = clone(obj[i]);&#13;&#10;        }&#13;&#10;        return copy;&#13;&#10;    }&#13;&#10;&#13;&#10;    // Handle Object&#13;&#10;    if (obj instanceof Object) {&#13;&#10;        copy = {};&#13;&#10;        for (var attr in obj) {&#13;&#10;            if (obj.hasOwnProperty(attr)) copy[attr] = clone(obj[attr]);&#13;&#10;        }&#13;&#10;        return copy;&#13;&#10;    }&#13;&#10;    throw new Error(&quot;Unable to copy obj.&quot;);&#13;&#10;}&#13;&#10;&#13;&#10;//&#13;&#10;// For the inner donut/pie/arc, we need to fill the other side (100 - row)&#13;&#10;// &#13;&#10;    var element = {};&#13;&#10;    element.name = &#039;filler&#039;;&#13;&#10;    element.y=(100 - options.series[0].data[0].y);&#13;&#10;    options.series[0].data.push(element);&#13;&#10;&#13;&#10;    //UNCOMMENT FOR STOP LIGHT COLORS&#13;&#10;    //&#13;&#10;    //if (options.series[0].data[0].y &lt;= 50) options.colors = [&#039;#722b22&#039;];&#13;&#10;    //else if (options.series[0].data[0].y &gt; 50 &amp;&amp; options.series[0].data[0].y &lt; 89) options.colors = [&#039;#e08e18&#039;];&#13;&#10;    //else options.colors = [&#039;#227247&#039;];&#13;&#10;    options.colors = [&#039;#bdd7fc&#039;];&#13;&#10;//&#13;&#10;// Create an outer donut/pie/arc.  Make it 100% and change the innerSize and Size.&#13;&#10;//&#13;&#10;    var copy = clone(options.series[0]);&#13;&#10;    copy.data.pop();&#13;&#10;    copy.data.pop();&#13;&#10;&#13;&#10;    element = {};&#13;&#10;    element.name = &#039;small-inner&#039;;&#13;&#10;    element.y = 100;&#13;&#10;    element.color = &#039;#D4D8E2&#039;;&#13;&#10;&#13;&#10;    copy.data.push(element);&#13;&#10;    &#13;&#10;    copy.size=&#039;93%&#039;;&#13;&#10;    copy.innerSize=&#039;85%&#039;;&#13;&#10;&#13;&#10;// &#13;&#10;// Instead of pushing, we unshift and put it in the front of the array so it will display on the bottom&#13;&#10;// &#13;&#10;    options.series.unshift (copy);&#13;&#10;&#13;&#10;//&#13;&#10;// Make the top slice larger&#13;&#10;//&#13;&#10;    options.series[1].size=&#039;100%&#039;;&#13;&#10;    options.series[1].innerSize=&#039;70%&#039;;&#13;&#10;&#13;&#10;&#13;&#10;//&#13;&#10;// Add the text&#13;&#10;//&#13;&#10;        options.title = {&#13;&#10;            useHTML: true,&#13;&#10;            verticalAlign: &#039;middle&#039;,&#13;&#10;            style: {&#13;&#10;                fontFamily: &#039;canada-type-gibson,Dotum,canada-type-gibson&#039;&#13;&#10;            },&#13;&#10;            text: &#039;&lt;div style=&quot;position:absolute;top:4px;left:-22px&quot;&gt;&lt;tspan style=&quot;color:#6B98E5;font-size:24px;font-weight:800;&quot;&gt;&#039; + options.series[1].data[0].y + &#039;%&lt;/tspan&gt;&lt;/div&gt;&#039;&#13;&#10;        };&#13;&#10;&#13;&#10;&#13;&#10;options.chart.spacingTop=0;&#13;&#10;//options.chart.spacingBottom=15;&#13;&#10;&#13;&#10;//options.chart.margin = [0,0,0,0];&#13;&#10;&#13;&#10;options.chart.marginTop=0;&#13;&#10;options.chart.marginLeft=0;&#13;&#10;options.chart.marginRight=0;&#13;&#10;options.chart.marginBottom=2;&#13;&#10;},"/>
