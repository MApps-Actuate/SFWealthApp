  <extendedProperties name="jschart.series.shadow" value="false"/>
  <extendedProperties name="chart.marker.auto" value="false"/>
  <extendedProperties name="jschart.client.script" value="beforeDrawSeries: function(series, seriesOptions, chart, seriesIndex)&#13;&#10;{&#13;&#10;    seriesOptions.animation = {&quot;duration&quot;: 4000};&#13;&#10;},&#13;&#10;&#13;&#10;/**&#13;&#10; * Called before chart instance is initially created.&#13;&#10; *&#13;&#10; * @param options&#13;&#10; *            chart options&#13;&#10; */&#13;&#10;beforeGeneration: function(options)&#13;&#10;{&#13;&#10;    options.tooltip = {&#13;&#10;        shared: true,&#13;&#10;        animation: false,&#13;&#10;        backgroundColor: &quot;#fff&quot;,&#13;&#10;        borderRadius: 5,&#13;&#10;        borderColor: &quot;#e1e1e1&quot;,&#13;&#10;        borderWidth: 1,&#13;&#10;        style: {&#13;&#10;            color:&quot;#363636&quot;,&#13;&#10;            fontFamily: &quot;Arial&quot;,&#13;&#10;            fontSize: &quot;12px&quot;,&#13;&#10;            fontWeight: 400,&#13;&#10;            padding: &quot;10px&quot;&#13;&#10;        },&#13;&#10;        useHTML: true,&#13;&#10;        formatter:  function () {&#13;&#10;            var arrMonths = [&quot;Feb&quot;, &quot;Mar&quot;, &quot;Apr&quot;, &quot;May&quot; ,&quot;Jun&quot;, &quot;Jul&quot;, &quot;Aug&quot;, &quot;Sep&quot;, &quot;Oct&quot;, &quot;Nov&quot;, &quot;Dec&quot;];&#13;&#10;            var	dt = new Date(this.points[0].x);&#13;&#10;            var fdt = arrMonths[dt.getMonth()] + &quot;-&quot; + dt.getFullYear().toString().slice(-2);&#13;&#10;            var s = {&quot;Total&quot;:&quot;&amp;#9679;&quot;, &quot;Managed ETF&quot;:&quot;&amp;#9670;&quot;, &quot;Managed Retirement&quot;:&quot;&amp;#9632;&quot;, &quot;Active Trading&quot;:&quot;&amp;#9650;&quot;, &quot;Finance One&quot;:&quot;&amp;#9660;&quot;};&#13;&#10;            &#13;&#10;            var total = this.points[0].y;&#13;&#10;            myTooltip = &#039;&lt;table &gt;&lt;tbody&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;b&gt;&#039; + fdt + &#039;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;b&gt;&#039; + this.points[0].series.name + &#039;:&lt;/b&gt;&lt;/td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;td style=&quot;text-align: center;&quot;&gt;&#039; + s[this.points[0].series.name] + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt;&lt;b&gt;&amp;nbsp;&amp;nbsp;$&#039; + this.points[0].y.toLocaleString() + &#039;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;b&gt;&#039; + this.points[1].series.name + &#039;:&lt;/b&gt;&lt;/td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;td style=&quot;text-align: center;&quot;&gt;&#039; + s[this.points[1].series.name] + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt;&amp;nbsp;&amp;nbsp;$&#039; + this.points[1].y.toLocaleString() + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&#039; + new Number((this.points[1].y / total)*100).toFixed(2).toLocaleString() + &quot;%)&quot; + &#039;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;b&gt;&#039; + this.points[2].series.name + &#039;:&lt;/b&gt;&lt;/td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;td style=&quot;text-align: center;&quot;&gt;&#039; + s[this.points[2].series.name] + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt;&amp;nbsp;&amp;nbsp;$&#039; + this.points[2].y.toLocaleString() + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&#039; + new Number((this.points[2].y / total)*100).toFixed(2).toLocaleString() + &quot;%)&quot; + &#039;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;            myTooltip += &#039;&lt;b&gt;&#039; + this.points[3].series.name + &#039;:&lt;/b&gt;&lt;/td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;td style=&quot;text-align: center;&quot;&gt;&#039; + s[this.points[3].series.name] + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt;&amp;nbsp;&amp;nbsp;$&#039; + this.points[3].y.toLocaleString() + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&#039; + new Number((this.points[3].y / total)*100).toFixed(2).toLocaleString() + &quot;%)&quot; + &#039;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            if (this.points.length == 5) {&#13;&#10;                myTooltip += &#039;&lt;tr&gt;&lt;td&gt;&#039;;&#13;&#10;                myTooltip += &#039;&lt;b&gt;&#039; + this.points[4].series.name + &#039;:&lt;/b&gt;&lt;/td&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;td style=&quot;text-align: center;&quot;&gt;&#039; + s[this.points[4].series.name] + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt;&amp;nbsp;&amp;nbsp;$&#039; + this.points[4].y.toLocaleString() + &#039;&lt;/td&gt;&lt;td style=&quot;text-align: right;&quot;&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(&#039; + new Number((this.points[4].y / total)*100).toFixed(2).toLocaleString() + &quot;%)&quot; + &#039;&lt;/td&gt;&lt;/tr&gt;&#039;;&#13;&#10;            }&#13;&#10;            myTooltip += &#039;&lt;/tbody&gt;&lt;/table&gt;&#039;;&#13;&#10;            return myTooltip;&#13;&#10;        } &#13;&#10;    };&#13;&#10;},"/>
